# ============================================================================
# DEVELOPMENT DOCKERFILE
# ============================================================================
# Purpose: Full development environment with all tools
# Size: ~800MB (includes dev dependencies and build tools)
# Use when: Local development, debugging, running tests
# 
# Build: docker build -f Dockerfile.dev -t naive-rag:dev .
# Run:   docker run -it --rm -v ${PWD}:/workspace naive-rag:dev bash
#
# Features:
# - All dev dependencies (pytest, black, mypy, etc.)
# - Git and build tools included
# - Volume mounting for live code updates
# - Interactive development
# - Not for production use
#
# See docs/DOCKER_GUIDE.md for complete documentation
# ============================================================================

# Development Dockerfile with UV and all dev tools
FROM python:3.11-slim

# Install system dependencies and UV
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set environment variables for faster builds
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Create non-root user
RUN useradd -m -u 1000 devuser && \
    mkdir -p /workspace /home/devuser/.cache && \
    chown -R devuser:devuser /workspace /home/devuser

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER devuser

# Copy dependency files
COPY --chown=devuser:devuser pyproject.toml uv.lock .python-version README.md ./

# Install dependencies using the lock file with cache mount
RUN --mount=type=cache,target=/home/devuser/.cache/uv,uid=1000,gid=1000 \
    uv venv && \
    uv sync --frozen

# Add virtual environment to PATH
ENV PATH="/workspace/.venv/bin:$PATH"
ENV PYTHONPATH="/workspace:$PYTHONPATH"

# Copy minimal structure needed for installation
COPY --chown=devuser:devuser src/__init__.py src/__init__.py
COPY --chown=devuser:devuser config/__init__.py config/__init__.py

# Install dependencies (includes LangGraph, LangChain, all dev tools)
RUN uv sync --all-extras

# Note: Application code will be mounted via volume for live updates
# This allows code changes without rebuilding
# Volume mount: -v ${PWD}:/workspace

# Create cache directories
RUN mkdir -p /home/devuser/.cache/embeddings /home/devuser/.cache/models

# Environment variables for development
ENV UV_CACHE_DIR="/home/devuser/.cache/uv"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Expose common ports
# 8000: API server
# 8888: Jupyter notebook
# 7687: Neo4j (if running internally)
# 5432: PostgreSQL (if running internally)
EXPOSE 8000 8888 7687 5432

# Default command (can be overridden)
CMD ["/bin/bash"]
