# Database Configuration
# PostgreSQL with pgvector
POSTGRES_URL=postgresql://raguser:your_password@localhost:5432/rag_benchmark
POSTGRES_DB=rag_benchmark
POSTGRES_USER=raguser
POSTGRES_PASSWORD=your_secure_password

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# LLM Configuration
# Provider options: gemini, openai, ollama
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-pro
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=  # Only needed for Ollama or custom endpoints
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Alternative: OpenAI Configuration
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=gpt-4-turbo
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1

# Alternative: Ollama Configuration (Local LLM)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL_NAME=llama3.1
# LLM_API_KEY=ollama  # Not used, but required by some clients

# Embedding Configuration
# Provider options: gemini, openai, ollama
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=  # Only for Ollama or custom endpoints
EMBEDDING_BATCH_SIZE=100

# Alternative: Ollama Embeddings (Local)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_BASE_URL=http://localhost:11434

# Ingestion Configuration
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=50
INGESTION_MAX_CHUNK_SIZE=1024
INGESTION_USE_SEMANTIC_CHUNKING=true
INGESTION_LLM_MODEL=gemini-1.5-flash  # Faster/cheaper model for processing

# Benchmark Configuration
BENCHMARK_DATASET_NAME=hotpotqa
BENCHMARK_NUM_QUESTIONS=50
BENCHMARK_BATCH_SIZE=10
BENCHMARK_OUTPUT_DIR=./benchmarks/results
BENCHMARK_SAMPLE_SEED=42  # For reproducibility

# Evaluation Configuration
EVAL_LLM_PROVIDER=gemini
EVAL_LLM_MODEL=gemini-1.5-pro  # Model for scoring answers
EVAL_LLM_API_KEY=your_api_key_here
EVAL_TEMPERATURE=0.0  # Low temperature for consistent scoring
EVAL_MAX_RETRIES=3
EVAL_RETRY_DELAY=2

# RAG Configuration
RAG_TOP_K=5  # Number of chunks to retrieve
RAG_MAX_HOPS=3  # Maximum hops for graph traversal
RAG_HYBRID_FUSION_STRATEGY=rrf  # Options: rrf, weighted, concatenation
RAG_HYBRID_VECTOR_WEIGHT=0.5  # Only for weighted strategy
RAG_HYBRID_GRAPH_WEIGHT=0.5

# Application Configuration
APP_ENV=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/app.log
ENABLE_METRICS=true

# Performance Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
ASYNC_CONCURRENCY=10  # Max concurrent async operations

# Caching Configuration (Optional)
ENABLE_EMBEDDING_CACHE=true
CACHE_DIR=./cache
CACHE_TTL_HOURS=24

# Development/Testing
PYTEST_TIMEOUT=300  # Test timeout in seconds
TEST_DB_URL=postgresql://raguser:test@localhost:5432/rag_test
TEST_NEO4J_URI=bolt://localhost:7688  # Separate test instance

# API Configuration (if building API)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# Cost Optimization
# Use these settings to minimize costs during development
USE_CACHE=true  # Cache LLM responses
USE_FLASH_MODEL=true  # Use Gemini Flash instead of Pro when possible
LOCAL_EMBEDDINGS=false  # Set to true to use Ollama embeddings locally
